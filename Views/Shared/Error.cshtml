@model ErrorViewModel
@{
    ViewData["Title"] = "Hata Oluştu";
}

<div class="s-content" style="padding: 60px 0; text-align: center;">
    <div class="row">
        <div class="col-twelve">
            <h1 class="text-danger" style="font-size: 3rem; color: #dc3545;">Bir Hata Oluştu</h1>
            <p class="lead" style="margin-top: 15px;">
                İstediğiniz sayfa işlenirken beklenmeyen bir durumla karşılaşıldı.
            </p>

            @if (Model.ShowRequestId)
            {
                <div style="background: #f8f9fa; border: 1px solid #e9ecef; padding: 15px; border-radius: 6px; display: inline-block; margin: 20px 0;">
                    <strong>İstek Numarası (Request ID):</strong> <code style="color: #d63384;">@Model.RequestId</code>
                </div>
            }

            <div style="margin-top: 30px;">
                <a href="/" class="btn btn--primary" style="margin-right: 10px;">Anasayfaya Dön</a>
                <a href="/Default/Index#contact" class="btn">İletişime Geç</a>
            </div>

            <hr style="margin: 40px 0; border-top: 1px solid #eee;">

            <div style="text-align: left; background: #fff3cd; color: #664d03; padding: 20px; border-radius: 6px; border: 1px solid #ffecb5;">
                <h4 style="margin-top: 0; color: #664d03;">Geliştirici Notu (Development Mode)</h4>
                <p style="margin-bottom: 10px;">
                    Uygulamanın detaylı hata çıktılarını görmek için geliştirme ortamını (Development Environment) aktif hale getirebilirsiniz.
                </p>
                <small>
                    <strong>Güvenlik Uyarısı:</strong> Canlıya alınan (production) uygulamalarda bu modun açık bırakılması önerilmez. Yerel ortamda hata ayıklamak için <code>ASPNETCORE_ENVIRONMENT</code> değişkenini <code>Development</code> olarak ayarlayabilirsiniz.
                </small>
            </div>
        </div>
    </div>
</div>