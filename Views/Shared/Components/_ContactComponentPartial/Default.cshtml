<section id="contact" class="s-contact target-section">

    <div class="overlay"></div>

    <div class="row narrow section-intro">
        <div class="col-full">
            <h3>İletişim</h3>
            <h1>Bana Ulaşın</h1>

            <p class="lead">Proje teklifleri, staj/iş fırsatları veya yazılım geliştirme üzerine her türlü fikir alışverişi için aşağıdaki formu doldurarak ya da doğrudan iletişim bilgilerim üzerinden bana ulaşabilirsiniz.</p>
        </div>
    </div>

    <div class="row contact__main">
        <div class="col-eight tab-full contact__form">
            <form name="contactForm" id="contactForm" method="post" action="/Default/SendMessage/">
                <fieldset>

                    <div class="form-field">
                        <input name="NameSurname" type="text" id="contactName" placeholder="Adınız Soyadınız" value="" minlength="2" required="" aria-required="true" class="full-width">
                    </div>
                    <div class="form-field">
                        <input name="Email" type="email" id="contactEmail" placeholder="E-posta Adresiniz" value="" required="" aria-required="true" class="full-width">
                    </div>
                    <div class="form-field">
                        <input name="Subject" type="text" id="contactSubject" placeholder="Konu" value="" class="full-width">
                    </div>
                    <div class="form-field">
                        <textarea name="MessageDetails" id="contactMessage" placeholder="Mesajınız..." rows="10" cols="50" required="" aria-required="true" class="full-width"></textarea>
                    </div>
                    <div class="form-field">
                        <button class="full-width btn--primary">Gönder</button>
                        <div class="submit-loader">
                            <div class="text-loader">Gönderiliyor...</div>
                            <div class="s-loader">
                                <div class="bounce1"></div>
                                <div class="bounce2"></div>
                                <div class="bounce3"></div>
                            </div>
                        </div>
                    </div>

                </fieldset>
            </form>

            <!-- contact-warning -->
            <div class="message-warning">
                Bir şeyler yanlış gitti. Lütfen tekrar deneyin.
            </div>

            <!-- contact-success -->
            <div class="message-success">
                Mesajınız başarıyla gönderildi, teşekkürler!<br>
            </div>

        </div>
        <div class="col-four tab-full contact__infos">
            <h4 class="h06">Telefon</h4>
            <p>
                Mobil: +90 (555) 000 00 00
            </p>

            <h4 class="h06">E-Posta</h4>
            <p>
                emrekaya@example.com<br>
                contact@emrekaya.com
            </p>

            <h4 class="h06">Konum</h4>
            <p>
                Karabük / Safranbolu<br>
                Türkiye
            </p>
        </div>

    </div>

</section>